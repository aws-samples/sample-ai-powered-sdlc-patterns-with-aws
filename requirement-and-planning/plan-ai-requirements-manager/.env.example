# AWS Configuration
# Use IAM roles (preferred) or AWS SSO for credentials — do not hardcode keys here.
# See README for minimum required IAM permissions.
# AWS Region identifier (e.g., us-west-2, us-east-1). Must match your Amazon Bedrock model region.
AWS_REGION=us-east-1

# JIRA Configuration (HTTPS required)
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
JIRA_URL=https://your-domain.atlassian.net/

# MCP Server Configuration
# REQUIRED: Path to your jira-mcp-server proxy script
MCP_SERVER_SCRIPT=./proxy_jira_mcp.py

# MCP Backend Configuration (used by proxy_jira_mcp.py)
# REQUIRED: URL of your backend MCP server (e.g., API Gateway endpoint)
MCP_BACKEND_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com/dev
# REQUIRED: Bearer token for authenticating with the backend MCP server
MCP_ACCESS_TOKEN=your-access-token-here

# Security Configuration
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Rate limiting (requests per time window)
# Adjust for expected production traffic patterns.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Input validation
# Review limits for your deployment scenario.
MAX_PROMPT_LENGTH=10000
MAX_JIRA_FIELD_LENGTH=32000
MAX_FILE_SIZE_MB=10

# MCP timeout (seconds)
MCP_TIMEOUT=30

# Session encryption key
# CRITICAL: Change in production! Do not use the default value.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_ENCRYPTION_KEY=change_this_in_production

# Optional: Override default settings
MAX_FEATURES_PER_ANALYSIS=5
MAX_STORIES_PER_EPIC=5
